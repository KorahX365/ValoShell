{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ValoShell",
  "version": "0.1.0",
  "identifier": "dev.s1moscs.valoshell",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ValoShell",
        "width": 1440,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "fullscreen": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0A0A0E"
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost asset-cache: http://asset-cache.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost asset-cache: http://asset-cache.localhost https: blob:; frame-src https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
